generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  CAJERO
}

enum Frecuencia {
  DIARIO
  MENSUAL
}

enum TipoCostoRecurrente {
  SUELDO
  OPERATIVO
}

enum EstadoDia {
  EXTRA_PENDIENTE
  INVALIDO
  PAGADO
}

model Usuario {
  id                 Int                    @id @default(autoincrement())
  nombre             String
  usuario            String                 @unique
  password           String
  rol                Rol
  activo             Boolean                @default(true)
  fechaDesactivacion DateTime?
  createdAt          DateTime               @default(now())
  ventas             Venta[]
  pagosRegistrados   PagoCostoRecurrente[]
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String
  productos Producto[]
}

model Producto {
  id            Int            @id @default(autoincrement())
  nombre        String
  precio        Decimal        @db.Decimal(10, 2)
  costoEstimado Decimal?       @db.Decimal(10, 2)
  activo        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  categoriaId   Int
  categoria     Categoria      @relation(fields: [categoriaId], references: [id])
  detalleVentas DetalleVenta[]
}

model Venta {
  id        Int            @id @default(autoincrement())
  fecha     DateTime       @default(now())
  total     Decimal        @db.Decimal(10, 2)
  usuarioId Int
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])
  detalles  DetalleVenta[]
}

model DetalleVenta {
  id         Int      @id @default(autoincrement())
  ventaId    Int
  venta      Venta    @relation(fields: [ventaId], references: [id])
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  subtotal   Decimal  @db.Decimal(10, 2)
}

model Gasto {
  id          Int      @id @default(autoincrement())
  descripcion String
  monto       Decimal  @db.Decimal(10, 2)
  fecha       DateTime @default(now())
}

model CostoRecurrente {
  id          Int                    @id @default(autoincrement())
  descripcion String
  monto       Decimal                @db.Decimal(10, 2)
  frecuencia  Frecuencia
  tipo        TipoCostoRecurrente
  activo      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  pagos       PagoCostoRecurrente[]
  dias        DiaCostoRecurrente[]
}

model PagoCostoRecurrente {
  id                Int                  @id @default(autoincrement())
  costoRecurrenteId Int
  costoRecurrente   CostoRecurrente      @relation(fields: [costoRecurrenteId], references: [id])
  periodoDesde      DateTime
  periodoHasta      DateTime
  monto             Decimal              @db.Decimal(10, 2)
  fechaPago         DateTime             @default(now())
  registradoPorId   Int
  registradoPor     Usuario              @relation(fields: [registradoPorId], references: [id])
  dias              DiaCostoRecurrente[]
}

model DiaCostoRecurrente {
  id                Int                  @id @default(autoincrement())
  costoRecurrenteId Int
  costoRecurrente   CostoRecurrente      @relation(fields: [costoRecurrenteId], references: [id])
  fecha             DateTime             @db.Date
  estado            EstadoDia
  nota              String?
  pagoId            Int?
  pago              PagoCostoRecurrente? @relation(fields: [pagoId], references: [id])
  createdAt         DateTime             @default(now())

  @@unique([costoRecurrenteId, fecha])
}

model Nota {
  id          Int      @id @default(autoincrement())
  contenido   String
  creadoPor   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}